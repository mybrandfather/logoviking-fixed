{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/prerender.mjs",
    "lint": "node --check server.js && node --check scripts/prerender.mjs && node --check scripts/crawl-built.mjs && node --test tests/source-seo.test.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "crawl": "node scripts/crawl-built.mjs",
    "verify": "npm run lint && npm test && npm run crawl",
    "start": "node server.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "clsx": "2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.16.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.15.1",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^7.3.6"
  }
}
